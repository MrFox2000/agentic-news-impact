# Copy to backend/.env

# Optional: without it the report uses the deterministic template.
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini

# Set to serve tools from a remote MCP server instead of the in-process one.
# MCP_URL=http://127.0.0.1:8765/mcp

# Set to 1 to use deterministic fixtures instead of the live providers.
# OFFLINE=1

ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
DEFAULT_DAYS=30
MOVE_THRESHOLD=2.0
